{
  "opencollection": "1.0.0",
  "info": {
    "name": "Metals Analytics Reference API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "access_key",
      "value": "{{access_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reference",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List supported symbols",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://metals-api.com/api/symbols"
          },
          "docs": "Returns all available currencies and metals supported by the API."
        }
      ]
    }
  ],
  "bundled": true
}